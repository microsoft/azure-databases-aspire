<Project Sdk="Aspire.AppHost.Sdk">

  <!-- Built outside the repo so none of its Directory.Build.* or central package versions apply. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.DocumentDB" Version="$(DocumentDBPackageVersion)" />
    <!-- Nightly consumer-variants sets these (as environment variables) to move past the package's dependency floors. -->
    <PackageReference Include="Aspire.Hosting.AppHost" Version="$(ConsumerAspireVersion)" Condition="'$(ConsumerAspireVersion)' != ''" />
    <PackageReference Include="MongoDB.Driver" Version="$(ConsumerMongoDriverVersion)" Condition="'$(ConsumerMongoDriverVersion)' != ''" />
  </ItemGroup>

  <Target Name="RequirePackageVersion" BeforeTargets="Restore;CollectPackageReferences">
    <Error Condition="'$(DocumentDBPackageVersion)' == ''" Text="Pass -p:DocumentDBPackageVersion=&lt;version of the packed nupkg&gt;." />
  </Target>

</Project>
